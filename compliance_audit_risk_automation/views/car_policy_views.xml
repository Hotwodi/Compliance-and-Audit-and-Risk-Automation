<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_car_policy_tree" model="ir.ui.view">
        <field name="name">car.policy.tree</field>
        <field name="model">car.policy</field>
        <field name="arch" type="xml">
            <tree string="Policies">
                <field name="name"/>
                <field name="policy_type"/>
                <field name="version"/>
                <field name="effective_date"/>
                <field name="review_date"/>
                <field name="owner_id"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_car_policy_form" model="ir.ui.view">
        <field name="name">car.policy.form</field>
        <field name="model">car.policy</field>
        <field name="arch" type="xml">
            <form string="Policy">
                <header>
                    <button name="action_set_active" type="object" string="Activate" class="oe_highlight" invisible="state not in ('draft','under_review')"/>
                    <button name="action_set_under_review" type="object" string="Under Review" invisible="state == 'active'"/>
                    <button name="action_set_retired" type="object" string="Retire" invisible="state == 'retired'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,under_review,retired"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="policy_type"/>
                            <field name="version"/>
                        </group>
                        <group>
                            <field name="effective_date"/>
                            <field name="review_date"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                    <group string="AI Compliance Gap">
                        <field name="ai_compliance_gap" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Content">
                            <field name="content" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_car_policy" model="ir.actions.act_window">
        <field name="name">Policies</field>
        <field name="res_model">car.policy</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new policy
            </p>
        </field>
    </record>
</odoo>
