<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_car_audit_engagement_tree" model="ir.ui.view">
        <field name="name">car.audit.engagement.tree</field>
        <field name="model">car.audit.engagement</field>
        <field name="arch" type="xml">
            <list string="Audit Engagements">
                <field name="name"/>
                <field name="audit_type"/>
                <field name="auditor"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="findings_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_car_audit_engagement_form" model="ir.ui.view">
        <field name="name">car.audit.engagement.form</field>
        <field name="model">car.audit.engagement</field>
        <field name="arch" type="xml">
            <form string="Audit Engagement">
                <header>
                    <button name="action_set_in_progress" type="object" string="Start" class="oe_highlight" invisible="state != 'planned'"/>
                    <button name="action_set_review" type="object" string="Submit for Review" invisible="state != 'in_progress'"/>
                    <button name="action_set_completed" type="object" string="Complete" class="oe_highlight" invisible="state != 'review'"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,in_progress,review,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="audit_type"/>
                            <field name="auditor"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="findings_count"/>
                        </group>
                    </group>
                    <group string="Scope">
                        <field name="scope" nolabel="1"/>
                    </group>
                    <group string="AI Risk Assessment">
                        <field name="ai_risk_assessment" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_car_audit_engagement" model="ir.actions.act_window">
        <field name="name">Audit Engagements</field>
        <field name="res_model">car.audit.engagement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new audit engagement
            </p>
        </field>
    </record>
</odoo>
